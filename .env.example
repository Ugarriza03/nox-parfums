# NOX Admin — variables de entorno (copiar a .env.local y completar).
# NUNCA versionar .env.local ni poner acá valores reales.
#
# Sólo se leen en el servidor. Sin ellas la tienda funciona igual y /admin
# muestra "Panel no configurado".

# Supabase → Project Settings → API → Project URL
NOX_SUPABASE_URL=

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_…)
# NO usar la Secret key ni service_role: la app las rechaza.
NOX_SUPABASE_PUBLISHABLE_KEY=

# Sólo para el entorno de producción de Vercel. Dejar sin definir hasta que
# MFA y las pruebas con Supabase real estén aprobadas.
# NOX_ADMIN_HABILITADO=true
